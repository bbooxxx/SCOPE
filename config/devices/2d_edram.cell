-MemCellType: eDRAM
-CellArea (F^2): 35
-CellAspectRatio: 1.46
-ReadMode: voltage
-AccessType: CMOS
-AccessCMOSWidth (F): 1.31
-DRAMCellCapacitance (F): 13e-15
-ResetVoltage (V): vdd
-SetVoltage (V): vdd
-MinSenseVoltage (mV): 10

// Device Library metadata (authoritative values used by SCOPE)
-ScopeDevice: 2D-eDRAM
-ScopeReadLatencyHybrid: Lr_s_Nrow
-ScopeReadLatencyPure: Lr_d_Nrow
-ScopeSelectedReadPath: pure
-ScopeReadEnergy: Er_Nrow
-ScopeReadIon: 120_uA_per_um
-ScopeReadVdd: 1.2_V
-ScopeReadDeltaV: 0.1_V
-ScopeWriteLatency: 20_ns
-ScopeWriteEnergy: ~10_fJ_per_bit
-ScopeLeakagePower: 0_in_v3_demo
-ScopeRefreshPower: not_applicable_in_v3
-ScopeEndurance: >1e15
-ScopeVariation: low
-ScopeDensity: ~35_F2_planar
-ScopeM3DScalability: 1_tier_2TOC
