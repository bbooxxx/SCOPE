-MemCellType: eDRAM
-CellArea (F^2): 35
-CellAspectRatio: 1.46
-ReadMode: voltage
-AccessType: CMOS
-AccessCMOSWidth (F): 1.31
-DRAMCellCapacitance (F): 13e-15
-ResetVoltage (V): vdd
-SetVoltage (V): vdd
-MinSenseVoltage (mV): 10

// Device Library metadata (authoritative values used by SCOPE)
-ScopeDevice: Si-eDRAM
-ScopeReadLatency: Lr_s_Nrow
-ScopeReadEnergy: Er_Nrow
-ScopeReadIon: 33.1_uA_per_um
-ScopeReadVdd: 1.2_V
-ScopeReadDeltaV: 0.1_V
-ScopeWriteLatency: 2_ns
-ScopeWriteEnergy: ~2.5_fJ_per_bit
-ScopeLeakagePower: counted_once_in_refresh
-ScopeRefreshPower: Pref_Nrow_at_10us_retention
-ScopeEndurance: >1e15
-ScopeVariation: low
-ScopeDensity: ~35_F2_layout_XL
-ScopeM3DScalability: N/A
