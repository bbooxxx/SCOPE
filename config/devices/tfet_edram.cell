-MemCellType: eDRAM
-CellArea (F^2): 35
-CellAspectRatio: 1.46
-ReadMode: voltage
-AccessType: CMOS
-AccessCMOSWidth (F): 1.31
-DRAMCellCapacitance (F): 13e-15
-ResetVoltage (V): vdd
-SetVoltage (V): vdd
-MinSenseVoltage (mV): 10

// Device Library metadata (authoritative values used by SCOPE)
-ScopeDevice: TFET-eDRAM
-ScopeReadLatency: Lr_s_Nrow
-ScopeReadEnergy: Er_Nrow
-ScopeWriteLatency: 3_ns
-ScopeWriteEnergy: ~10_fJ_per_bit
-ScopeLeakagePower: equal_to_Pref
-ScopeRefreshPower: ~100_aW_per_bit
-ScopeEndurance: >1e15
-ScopeVariation: low
-ScopeDensity: ~35_F2_layout_XL
-ScopeM3DScalability: N/A
