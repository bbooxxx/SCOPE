      "capacity_bytes": 32768,
      "associativity": 8,
      "line_bytes": 64,
      "replacement_policy": "LRU",
      "banks": 1,
      "ber": 1e-12,
      "wear_leveling_efficiency": 1.0,
      "candidates": [
        {"device": "SRAM", "destiny_config": "config/scope_l1_sram.cfg"},
        {"device": "SOT-MRAM", "destiny_config": "config/scope_l1_mram.cfg"},
        {
          "device": "2D-eDRAM",
          "destiny_config": "config/scope_l1_edram.cfg",
          "refresh_interval_us": 10,
          "retention_time_us": 10
        }
      ]
    },
    {
      "name": "L2",
      "device": "2D-eDRAM",
      "destiny_config": "config/scope_l2_edram.cfg",
      "capacity_bytes": 524288,
      "associativity": 8,
      "line_bytes": 64,
      "replacement_policy": "LRU",
      "banks": 4,
      "ber": 1e-10,
      "wear_leveling_efficiency": 1.0,
      "refresh_interval_us": 10,
      "retention_time_us": 10,
      "candidates": [
        {"device": "SRAM", "destiny_config": "config/scope_l2_sram.cfg"},
        {"device": "SOT-MRAM", "destiny_config": "config/scope_l2_mram.cfg"},
        {"device": "2D-eDRAM", "destiny_config": "config/scope_l2_edram.cfg"}
