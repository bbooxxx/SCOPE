{
  "name": "three-level heterogeneous example (one mapping, not a restriction)",
  "destiny_binary": "destiny",
  "device_library": "config/device_library.json",
  "core_to_l1_latency_ns": 0.0,
  "refill_on_critical_path": false,
  "constraints": {
    "ber_max": 1e-8
  },
  "workload": {
    "read_fraction": 0.75,
    "memory_access_rate_per_s": 50000000,
