{
  "schema_version": 9,
  "source": "SCOPE device library; AsyFET uses the user-authorized TFET parameters.",
  "semantics": {
    "dynamic_energy_unit": "fJ/bit/access",
    "leakage_unit": "per data bit unless a model is named",
    "edram_read_functions": "DESTINY selects Nrow/Ncolumn and C_RBL; SCOPE evaluates Lr=C_RBL*deltaV/Ion and Er=0.5*C_RBL*(Vdd^2-(Vdd-deltaV)^2)",
    "sa_overlay": "DESTINY native SA is audited; v5 removes the legacy I-V converter and evaluates compatible topology factors from a common voltage-latch baseline",
    "m3d_overlay": "generic tier/via model applied after a single-tier DESTINY run to avoid double counting",
    "array_nonideal": "DESTINY supplies physical RWL/RBL resistance and Nrow/Ncol; SCOPE adds worst-case IR drop, 2T0C coupling/read crosstalk, MRAM line loss, and STT read-disturb reliability",
    "sa_accuracy": "behavior-level Gaussian decision model with topology-specific required signal and input-referred noise",
    "m3d_latency": "sum cumulative segment resistance times each segment capacitance (Elmore); no fixed driven-hop floor",
    "feature_switches": "array nonideality, configurable peripheral overlays, and M3D cost overlays can be disabled independently without changing the trace, capacity, cache policy, NoC, or LPDDR inputs",
    "peripheral_ablation": "disabled means use the DESTINY-native sense amplifier and ignore SCOPE peripheral overrides; the native peripheral is not removed or assigned zero power",
    "m3d_ablation": "disabled removes M3D latency, energy, and footprint accounting while retaining the configured cache capacity, so the result is a controlled model ablation rather than a different cache hierarchy",
    "osfet_bti": "Excluded from v9 refresh latency and power."
  },
  "tag_address_bits": 49,
  "tag_state_bits_per_line": 2,
  "tag_sram_leakage_pw_per_bit": 27.5,
  "sense_amplifier_models": {
    "voltage": {
      "latency_factor": 1,
      "energy_factor": 1,
      "leakage_factor": 0.01,
      "basis": "DESTINY converter-free voltage latch baseline",
      "required_input_signal_mv": 50,
      "input_referred_noise_mv": 8,
      "accuracy_tradeoff": "waits for a larger bitline voltage; lower input-offset/noise assumption"
    },
    "current": {
      "latency_factor": 0.6,
      "energy_factor": 1.2,
      "leakage_factor": 0.02,
      "basis": "behavior-level topology sweep: about 40% faster with power tradeoff",
      "required_input_signal_mv": 20,
      "input_referred_noise_mv": 12,
      "accuracy_tradeoff": "low input impedance permits an earlier decision, but current-reference and mirror mismatch increase input-referred uncertainty"
    }
  },
  "m3d_defaults": {
    "enabled": false,
    "model": "elmore_staircase",
    "tiers": 1,
    "bottom_tier_hops": 0,
    "vdd": 1.2,
    "via_resistance_ohm": 5.5,
    "via_capacitance_ff": 0.1,
    "via_pitch_um": 0.2,
    "read_swing_v": 0.1,
    "write_swing_v": 1.2,
    "read_current_ua": 0,
    "write_current_ua": 0,
    "read_pulse_ns": 0,
    "write_pulse_ns": 0,
    "source": "M3D-MDA Table 1 (5.5 ohm, 0.1 fF, 0.2 um pitch). Swings are SCOPE assumptions; independent conduction current is uncharacterized and defaults to zero.",
    "geometry_basis": "Square equal-area bank blocks unless array_count/array_height_um/array_width_um are supplied.",
    "active_lines_basis": "line_bits+1 per operation: one wordline plus transferred bitlines; common swing approximation."
  },
